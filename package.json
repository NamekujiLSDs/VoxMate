{
  "name": "voxmate",
  "appname": "VoxMate Client",
  "displayName": "VoxMate Client",
  "productName": "VoxMate Client",
  "version": "1.1.5",
  "description": "Client of Voxiom player, by the Voxiom player, for the Voxiom player.",
  "main": "main.js",
  "scripts": {
    "test": "electron .",
    "build": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder --win --mac --linux --publish never",
    "publish": "electron-builder --win --x64 --publish always"
  },
  "author": "Namekuji",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "electron": "^10.4.7",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "discord-rpc": "^3.2.0",
    "electron-localshortcut": "^3.2.1",
    "electron-log": "^5.2.4",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.namekuji.voxmate",
    "productName": "VoxMate Client",
    "directories": {
      "output": "./dist",
      "buildResources": "./build"
    },
    "win": {
      "artifactName": "VoxMate-Windows-${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game",
      "artifactName": "VoxMate-Linux-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64"]
        }
      ],
      "artifactName": "VoxMate-macOS-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NamekujiLSDs",
        "repo": "VoxMate"
      }
    ]
  }
}